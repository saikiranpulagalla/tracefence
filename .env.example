TRACEFENCE_ENV=development
TRACEFENCE_DATABASE_URL=sqlite+pysqlite:///./data/tracefence.db
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRACEFENCE_OPERATOR_KEY=
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRACEFENCE_TOKEN_HASH_SECRET=
# Required independent HMAC key for evidence manifests. Never reuse either key above.
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRACEFENCE_EVIDENCE_SIGNING_KEY=
TRACEFENCE_HEARTBEAT_INTERVAL_SECONDS=2
TRACEFENCE_LEASE_TTL_SECONDS=7
TRACEFENCE_LEASE_SCAN_INTERVAL_SECONDS=2
TRACEFENCE_CONTROL_CONVERGENCE_SLO_SECONDS=10
TRACEFENCE_CONTROL_PLANE_WORKERS=8
TRACEFENCE_MAX_ACTIVE_RUNS=32
TRACEFENCE_MAX_NODES_PER_RUN=128
TRACEFENCE_MAX_GRAPH_DEPTH=12
TRACEFENCE_MAX_CHILDREN_PER_NODE=16
TRACEFENCE_MAX_COMMANDS_PER_RUN=128
TRACEFENCE_MAX_ACTIONS_PER_RUN=2048
TRACEFENCE_MAX_PROPOSALS_PER_RUN=256
TRACEFENCE_PROOF_CACHE_SECONDS=2
TRACEFENCE_MAX_REQUEST_BYTES=262144
TRACEFENCE_RATE_LIMIT_PER_MINUTE=600
TRACEFENCE_PROOF_RATE_LIMIT_PER_MINUTE=60
TRACEFENCE_RATE_LIMIT_MAX_BUCKETS=10000
TRACEFENCE_OTEL_METRIC_EXPORT_INTERVAL_MS=2000
TRACEFENCE_OTEL_EXPORT_TIMEOUT_MS=5000
TRACEFENCE_BUILD_COMMIT=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
SIGNOZ_URL=http://localhost:8080
SIGNOZ_MCP_URL=http://localhost:8000/mcp
SIGNOZ_API_KEY=
# Required only when provisioning alerts. Must match an existing SigNoz channel name.
TRACEFENCE_NOTIFICATION_CHANNEL=
FRONTEND_ORIGIN=http://localhost:5173
