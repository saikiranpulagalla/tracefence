[
  {
    "alert": "TraceFence Stale Action Committed",
    "alertType": "METRIC_BASED_ALERT",
    "description": "A side effect committed under invalid control state.",
    "ruleType": "threshold_rule",
    "version": "v5",
    "schemaVersion": "v2alpha1",
    "condition": {
      "compositeQuery": {
        "queryType": "builder",
        "panelType": "graph",
        "unit": "none",
        "queries": [
          {
            "type": "builder_query",
            "spec": {
              "name": "A",
              "signal": "metrics",
              "stepInterval": 60,
              "aggregations": [
                {
                  "metricName": "tracefence_stale_actions_committed_total",
                  "timeAggregation": "increase",
                  "spaceAggregation": "sum"
                }
              ],
              "limit": 100,
              "order": [
                {
                  "key": {
                    "name": "__result"
                  },
                  "direction": "desc"
                }
              ],
              "filter": {
                "expression": ""
              },
              "groupBy": [],
              "legend": "TraceFence Stale Action Committed"
            }
          }
        ]
      },
      "selectedQueryName": "A",
      "thresholds": {
        "kind": "basic",
        "spec": [
          {
            "name": "critical",
            "op": "above",
            "matchType": "at_least_once",
            "target": 0,
            "channels": [
              "${TRACEFENCE_NOTIFICATION_CHANNEL}"
            ]
          }
        ]
      }
    },
    "evaluation": {
      "kind": "rolling",
      "spec": {
        "evalWindow": "5m",
        "frequency": "1m"
      }
    },
    "notificationSettings": {
      "groupBy": [],
      "renotify": {
        "enabled": false,
        "interval": "30m",
        "alertStates": [
          "firing"
        ]
      },
      "usePolicy": false
    },
    "labels": {
      "severity": "critical",
      "team": "tracefence",
      "component": "control-plane"
    },
    "annotations": {
      "description": "A side effect committed under invalid control state. Current value: {{$value}}.",
      "summary": "TraceFence Stale Action Committed crossed {{$threshold}}"
    }
  },
